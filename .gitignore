# 忽略 macOS 系统文件
.DS_Store

# 忽略 Python 缓存
__pycache__/
*.pyc
# 忽略派生的 embedding 缓存
data/processed/
# 忽略用户自行准备的本地模型
data/models/

# 忽略项目虚拟环境
.venv/

# 忽略应用运行目录与日志（本地生成，不进入版本库）
data/app/
logs/
# results/ 只保留文件管理说明，运行记录不进入版本库
results/*
!results/README.md

# 忽略 DuRetrieval 数据目录：按约定不纳入版本库，可由 docs/datasets.md 记录的 commit 重新下载
data/raw/duretrieval/

# 导出材料（课程报告 Word / PPT，不入库）
docs/export/

# 发布包构建输出（不入库）
dist/

# 计算机使用工具运行时截图（不入库）
.dsh-computer-use/
